<UserControl x:Class="Pos.Desktop.Users.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Pos.Desktop.Common"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Pos.Desktop;component/Themes/AppColors.xaml" />
                <ResourceDictionary Source="/Pos.Desktop;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToActiveStatusTextConverter x:Key="IsActiveTextConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Usuarios" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Administra los operadores locales y sus roles." Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button x:Name="NewUserButton" Grid.Column="1" Content="+ Nuevo usuario" VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewUserCommand}" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding StatusMessage}" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
            <DataGrid x:Name="UsersGrid" BorderThickness="0" Background="Transparent"
                      ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditUserCommand}"
                                  CommandParameter="{Binding SelectedUser}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName}" Width="*" />
                    <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="160" />
                    <DataGridTextColumn Header="Rol" Binding="{Binding RoleName}" Width="140" />
                    <DataGridTextColumn Header="Estado" Width="90"
                                         Binding="{Binding IsActive, Converter={StaticResource IsActiveTextConverter}, Mode=OneWay}" />
                    <DataGridTemplateColumn Header="Acciones" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TableIconButtonStyle}"
                                        ToolTip="Editar usuario"
                                        AutomationProperties.Name="Editar usuario"
                                        Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Fill="{StaticResource PrimaryTextBrush}" Data="{StaticResource IconEdit}" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding GeneralError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
