<Window x:Class="Pos.Desktop.Users.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nuevo usuario — PosPlatform"
        Height="440" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="32" IsEnabled="{Binding IsNotBusy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                    Text="Nuevo usuario"
                    FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Usuario" Target="{Binding ElementName=UsernameTextBox}" />
            <TextBox x:Name="UsernameTextBox" Grid.Row="0" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="0"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="1" Grid.Column="0" Content="Nombre" Target="{Binding ElementName=DisplayNameTextBox}" />
            <TextBox x:Name="DisplayNameTextBox" Grid.Row="1" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="1"
                    Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="2" Grid.Column="0" Content="Rol" Target="{Binding ElementName=RoleComboBox}" />
            <ComboBox x:Name="RoleComboBox" Grid.Row="2" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="2"
                    ItemsSource="{Binding Roles}" DisplayMemberPath="Name"
                    SelectedItem="{Binding SelectedRole}" />

            <Label Grid.Row="3" Grid.Column="0" Content="Contraseña" Target="{Binding ElementName=PasswordBox}" />
            <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="3" />

            <Label Grid.Row="4" Grid.Column="0" Content="Confirmar contraseña" Target="{Binding ElementName=ConfirmPasswordBox}" />
            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="4" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="4" />
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding GeneralError}"
                    Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="160" Height="6" VerticalAlignment="Center" />
            <TextBlock Text="Guardando…" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="120" Margin="0,0,8,0" TabIndex="6"
                    Command="{Binding CancelCommand}" />
            <Button x:Name="SaveButton" Content="Guardar" Width="120" TabIndex="5"
                    IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
