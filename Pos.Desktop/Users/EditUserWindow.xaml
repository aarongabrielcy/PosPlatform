<Window x:Class="Pos.Desktop.Users.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Editar usuario — PosPlatform"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="32" IsEnabled="{Binding IsNotBusy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                    Text="Editar usuario"
                    FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Usuario" Target="{Binding ElementName=UsernameTextBox}" />
                <TextBox x:Name="UsernameTextBox" Grid.Row="0" Grid.Column="1"
                        Margin="0,6" Padding="6,4" TabIndex="0"
                        Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="1" Grid.Column="0" Content="Nombre" Target="{Binding ElementName=DisplayNameTextBox}" />
                <TextBox x:Name="DisplayNameTextBox" Grid.Row="1" Grid.Column="1"
                        Margin="0,6" Padding="6,4" TabIndex="1"
                        Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="2" Grid.Column="0" Content="Rol" Target="{Binding ElementName=RoleComboBox}" />
                <ComboBox x:Name="RoleComboBox" Grid.Row="2" Grid.Column="1"
                        Margin="0,6" Padding="6,4" TabIndex="2"
                        ItemsSource="{Binding Roles}" DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedRole}" />

                <Label Grid.Row="3" Grid.Column="0" Content="Estado" />
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10" VerticalAlignment="Center"
                        Text="{Binding IsActiveText, Mode=OneWay}" />
            </Grid>

            <Border BorderThickness="0,1,0,0" BorderBrush="#DDDDDD" Margin="0,16,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Restablecer contraseña" FontWeight="Bold" Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Nueva contraseña" Target="{Binding ElementName=NewPasswordBox}" />
                        <PasswordBox x:Name="NewPasswordBox" Grid.Row="0" Grid.Column="1"
                                Margin="0,6" Padding="6,4" TabIndex="3" />

                        <Label Grid.Row="1" Grid.Column="0" Content="Confirmar contraseña" Target="{Binding ElementName=ConfirmNewPasswordBox}" />
                        <PasswordBox x:Name="ConfirmNewPasswordBox" Grid.Row="1" Grid.Column="1"
                                Margin="0,6" Padding="6,4" TabIndex="4" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="ResetPasswordButton" Content="Restablecer contraseña"
                                MinWidth="180" Padding="12,6" TabIndex="5"
                                Click="OnResetPasswordClick" />
                        <TextBlock Text="{Binding PasswordResetMessage}" Foreground="Green"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding GeneralError}"
                    Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="160" Height="6" VerticalAlignment="Center" />
            <TextBlock Text="Procesando…" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="ToggleActiveButton" Content="{Binding ToggleActiveButtonText}"
                        MinWidth="100" Padding="12,6" TabIndex="6"
                        Command="{Binding ToggleActiveCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CloseButton" Content="Cerrar"
                        MinWidth="100" Padding="12,6" Margin="0,0,8,0" TabIndex="8"
                        Command="{Binding CancelCommand}" />
                <Button x:Name="SaveButton" Content="Guardar cambios"
                        MinWidth="130" Padding="16,6" TabIndex="7"
                        IsDefault="True" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
