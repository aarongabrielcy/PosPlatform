<UserControl x:Class="Pos.Desktop.LocalConfiguration.LocalConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Pos.Desktop;component/Themes/AppColors.xaml" />
                <ResourceDictionary Source="/Pos.Desktop;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="DetailValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Configuración" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Configuración local de esta máquina: impresora, cajón y datos del sistema."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

            <!-- General / Negocio (sección 21/22: solo lectura) -->
            <TabItem Header="General">
                <Grid Margin="0,16,0,0">
                    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Left" MinWidth="360">
                        <StackPanel>
                            <TextBlock Text="Negocio" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Organización" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding OrganizationName}" Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Impresora (sección 30 de la tarea: la más importante de esta pantalla) -->
            <TabItem Header="Impresora">
                <Grid Margin="0,16,0,0">
                    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Left" MinWidth="420">
                        <StackPanel>
                            <CheckBox Content="Habilitar impresión" IsChecked="{Binding PrinterEnabled}" Margin="0,0,0,16" />

                            <TextBlock Text="Impresora" Style="{StaticResource FieldLabelStyle}" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePrinters}"
                                          SelectedItem="{Binding SelectedPrinterName}" IsEditable="False" />
                                <Button Grid.Column="1" Content="Actualizar impresoras" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RefreshPrintersCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding PrinterAvailabilityWarning}" Foreground="{StaticResource WarningBrush}"
                                       TextWrapping="Wrap" Margin="0,-10,0,16" />

                            <TextBlock Text="Ancho de papel" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Margin="0,0,0,16" ItemsSource="{Binding PaperWidthOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedPaperWidth}" />

                            <CheckBox Content="Imprimir automáticamente al completar una venta"
                                      IsChecked="{Binding AutoPrint}" Margin="0,0,0,8" />
                            <CheckBox Content="Cortar papel" IsChecked="{Binding CutPaper}" Margin="0,0,0,20" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Imprimir prueba" Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,12,0" Command="{Binding TestPrintCommand}" />
                                <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Cajón (fundación, sección 17/38: sin apertura física) -->
            <TabItem Header="Cajón">
                <Grid Margin="0,16,0,0">
                    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Left" MinWidth="420">
                        <StackPanel>
                            <CheckBox Content="Habilitar cajón" IsChecked="{Binding CashDrawerEnabled}" Margin="0,0,0,12" />
                            <CheckBox Content="Abrir al abrir caja" IsChecked="{Binding OpenOnRegisterOpen}" Margin="0,0,0,12" />

                            <TextBlock Text="Conexión" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding CashDrawerConnectionModeLabel}" Style="{StaticResource DetailValueStyle}" />

                            <Border Background="{StaticResource SidebarHoverBrush}" CornerRadius="6" Padding="12" Margin="0,4,0,20">
                                <TextBlock Text="{Binding CashDrawerFoundationNotice}" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>

                            <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left" Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Sistema (solo lectura, sección 24: sin secretos) -->
            <TabItem Header="Sistema">
                <Grid Margin="0,16,0,0">
                    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Left" MinWidth="420">
                        <StackPanel>
                            <TextBlock Text="Versión de la aplicación" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource DetailValueStyle}" />

                            <TextBlock Text="Archivo de configuración local" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding SettingsFilePath}" Style="{StaticResource DetailValueStyle}" />

                            <TextBlock Text="Activación" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Text="{Binding ActivationStatusText}" Style="{StaticResource DetailValueStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
