<Window x:Class="Pos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pos.Desktop"
        xmlns:common="clr-namespace:Pos.Desktop.Common"
        xmlns:main="clr-namespace:Pos.Desktop.Main"
        xmlns:dashboard="clr-namespace:Pos.Desktop.Dashboard"
        xmlns:sales="clr-namespace:Pos.Desktop.Sales"
        xmlns:salesHistory="clr-namespace:Pos.Desktop.Sales.History"
        xmlns:catalog="clr-namespace:Pos.Desktop.Products.Catalog"
        xmlns:inventory="clr-namespace:Pos.Desktop.Inventory"
        xmlns:register="clr-namespace:Pos.Desktop.Register"
        xmlns:settings="clr-namespace:Pos.Desktop.Settings"
        xmlns:auditProducts="clr-namespace:Pos.Desktop.Audit.Products"
        xmlns:notifications="clr-namespace:Pos.Desktop.AdministrativeNotifications"
        mc:Ignorable="d"
        Title="PosPlatform" Height="768" Width="1366" MinHeight="720" MinWidth="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Pos.Desktop;component/Themes/AppColors.xaml" />
                <ResourceDictionary Source="/Pos.Desktop;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <common:NavigationSectionIconConverter x:Key="NavigationSectionIconConverter" />

            <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
                <dashboard:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type sales:SalesViewModel}">
                <sales:SalesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type salesHistory:SalesHistoryViewModel}">
                <salesHistory:SalesHistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type catalog:ProductsViewModel}">
                <catalog:ProductsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type inventory:InventoryViewModel}">
                <inventory:InventoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type register:RegisterViewModel}">
                <register:RegisterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
                <settings:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type auditProducts:ProductAuditViewModel}">
                <auditProducts:ProductAuditView />
            </DataTemplate>

            <!-- Ítem del sidebar: icono siempre visible + texto/ToolTip. El texto se oculta con
                 el sidebar colapsado, el ToolTip permanece disponible siempre (sección 3). -->
            <DataTemplate DataType="{x:Type main:NavigationItem}">
                <Grid ToolTip="{Binding Label}" Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center"
                          Fill="{StaticResource SidebarTextBrush}"
                          Data="{Binding Section, Converter={StaticResource NavigationSectionIconConverter}}" />

                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                               Foreground="{StaticResource SidebarTextBrush}"
                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </DataTemplate>

            <!-- Ítem seleccionado: fondo Accent + indicador lateral. Hover (SidebarHoverBrush)
                 queda visualmente distinto del seleccionado (sección 13). -->
            <Style x:Key="NavigationListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="Margin" Value="8,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                    Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header compacto: hamburguesa + título de sección + estado de caja. No repite
             usuario/rol completos (ya están en el pie del sidebar). -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Padding="12,10" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ToggleSidebarButton" Grid.Column="0" Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Expandir/colapsar menú"
                        Command="{Binding ToggleSidebarCommand}">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource PrimaryTextBrush}"
                          Data="{StaticResource IconMenu}" />
                </Button>

                <TextBlock x:Name="SectionTitleText" Grid.Column="1" Text="{Binding CurrentNavigationTitle}"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center"
                                Visibility="{Binding IsRegisterOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding RegisterName}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,8,0" />
                        <Border Background="{StaticResource SuccessBrush}" CornerRadius="10" Padding="8,2">
                            <TextBlock Text="{Binding RegisterStatusText}" Foreground="White" FontSize="11" />
                        </Border>
                    </StackPanel>

                    <!-- Campana de notificaciones (TAREA 24E, sección 24): visible únicamente con
                         ViewProductAudit; badge oculto si UnreadCount == 0. -->
                    <Button x:Name="NotificationBellButton" Width="36" Height="36" Padding="0" Margin="0,0,12,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Notificaciones"
                            Command="{Binding NotificationCenterViewModel.ToggleCommand}"
                            Visibility="{Binding CanViewNotifications, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource PrimaryTextBrush}"
                                  Data="{StaticResource IconBell}" />
                            <Border x:Name="NotificationBadge" Background="{StaticResource DangerBrush}" CornerRadius="8"
                                    MinWidth="16" Height="16" Padding="3,0" Margin="0,-5,-5,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Visibility="{Binding NotificationCenterViewModel.HasUnread, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock x:Name="NotificationBadgeText" Text="{Binding NotificationCenterViewModel.UnreadCount}"
                                           Foreground="White" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="CloseRegisterButton" Content="Cerrar caja" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CloseRegisterCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar colapsable: expandido ~240px, colapsado ~68px (sección 3). -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
                <DockPanel>
                    <!-- Branding: isotipo simple hecho en XAML, sin binarios (sección 6). El
                         nombre se oculta con el sidebar colapsado; el isotipo permanece. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,16,22">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="BrandNameText" Text="POSPlatform" FontWeight="Bold" FontSize="16"
                                   VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource SidebarTextBrush}"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Usuario/rol + cerrar sesión, en la parte inferior (sección 8). -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SidebarHoverBrush}" BorderThickness="0,1,0,0" Padding="14,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource SidebarHoverBrush}">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource SidebarTextBrush}"
                                          Data="{StaticResource IconUser}" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock x:Name="DisplayNameText" Text="{Binding DisplayName}"
                                               Foreground="{StaticResource SidebarTextBrush}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RoleNameText" Text="{Binding RoleName}"
                                               Foreground="{StaticResource SidebarSecondaryTextBrush}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="LogoutButton" Style="{StaticResource SidebarFooterButtonStyle}"
                                    Padding="0,8" Margin="0,12,0,0"
                                    ToolTip="Cerrar sesión" Command="{Binding LogoutCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource SidebarTextBrush}"
                                          Data="{StaticResource IconLogout}" />
                                    <TextBlock Text="Cerrar sesión" Foreground="{StaticResource SidebarTextBrush}" Margin="10,0,0,0"
                                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding LogoutBlockedMessage}" Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="NavigationListBox" Margin="0,4" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}"
                             ItemContainerStyle="{StaticResource NavigationListBoxItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <!-- Contenido central: star sizing, sin anchos rígidos (sección 3). -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding CloseRegisterBlockedMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="16,10,16,0" />

                <ContentControl x:Name="ShellContentControl" Grid.Row="1" Content="{Binding CurrentViewModel}" />
            </Grid>

            <!-- Panel del centro de notificaciones (TAREA 24E, sección 25): right drawer dentro
                 del shell, nunca una Window nueva. Se declara al final de este Grid para quedar
                 por encima de sidebar/contenido (misma celda, orden de dibujo). -->
            <notifications:NotificationCenterView x:Name="NotificationCenterPanel" Grid.Column="0" Grid.ColumnSpan="2"
                                                    HorizontalAlignment="Right"
                                                    DataContext="{Binding NotificationCenterViewModel}"
                                                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Window>
