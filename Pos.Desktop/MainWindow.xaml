<Window x:Class="Pos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pos.Desktop"
        mc:Ignorable="d"
        Title="PosPlatform" Height="450" Width="800">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text=" — " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RoleName}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CloseRegisterButton" Content="Cerrar caja"
                            Padding="10,4" Margin="0,0,8,0" Command="{Binding CloseRegisterCommand}" />
                    <Button x:Name="LogoutButton" Content="Cerrar sesión"
                            Padding="10,4" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="12,8" Background="#EAF6EA" BorderBrush="#C7E6C7" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="Caja" FontWeight="Bold" />
                    <TextBlock Text="{Binding RegisterName}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <TextBlock Text="Apertura" FontWeight="Bold" />
                    <TextBlock Text="{Binding RegisterOpenedAtText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                    <TextBlock Text="Fondo inicial" FontWeight="Bold" />
                    <TextBlock Text="{Binding RegisterOpeningAmountText}" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Estado" FontWeight="Bold" />
                    <TextBlock Text="{Binding RegisterStatusText}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding LogoutBlockedMessage}"
                    Foreground="Red" Margin="12,8" TextWrapping="Wrap" />

        <Grid />
    </DockPanel>
</Window>
