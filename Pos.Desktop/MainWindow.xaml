<Window x:Class="Pos.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pos.Desktop"
        mc:Ignorable="d"
        Title="PosPlatform" Height="450" Width="800">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text=" — " VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RoleName}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="LogoutButton" Content="Cerrar sesión"
                        Padding="10,4" Command="{Binding LogoutCommand}" />
            </Grid>
        </Border>

        <Grid />
    </DockPanel>
</Window>
