<Window x:Class="Pos.Desktop.Enforcement.CredentialRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Recuperación de credencial — PosPlatform"
        Height="380" Width="520"
        MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="32" IsEnabled="{Binding IsNotBusy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                    Text="PosPlatform"
                    FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                    Text="La credencial de esta instalación ya no es válida. Solicite a su administrador un código de recuperación."
                    Margin="0,0,0,16" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <Label Content="Código de recuperación" Target="{Binding ElementName=RecoveryCodeTextBox}" />
            <TextBox x:Name="RecoveryCodeTextBox"
                    Padding="6,4" TabIndex="0"
                    Text="{Binding RecoveryCode, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding GeneralError}"
                    Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="160" Height="6" VerticalAlignment="Center" />
            <TextBlock Text="Reactivando…" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CerrarCajaAbiertaButton" Content="Cerrar caja abierta" Width="160" Margin="0,0,8,0"
                    TabIndex="3" IsEnabled="{Binding IsNotBusy}"
                    Click="OnCerrarCajaAbiertaClick" />
            <Button x:Name="SalirButton" Content="Salir" Width="100" Margin="0,0,8,0"
                    TabIndex="2" IsCancel="True" />
            <Button x:Name="ReactivarButton" Content="Reactivar" Width="160" TabIndex="1"
                    IsDefault="True" IsEnabled="{Binding IsNotBusy}"
                    Click="OnReactivarClick" />
        </StackPanel>
    </Grid>
</Window>
