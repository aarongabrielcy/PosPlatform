<UserControl x:Class="Pos.Desktop.Audit.Products.ProductAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:productAudit="clr-namespace:Pos.Domain.ProductAudit;assembly=Pos.Domain"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Pos.Desktop;component/Themes/AppColors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" MinWidth="480" />
            <ColumnDefinition Width="3*" MinWidth="280" MaxWidth="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Auditoría &gt; Productos" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                <TextBlock Text="Auditoría" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Consulta cambios administrativos realizados en productos." Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Visibility="{Binding HasProductFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ProductFilterText" Text="{Binding ProductFilterLabel}" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}" Margin="4,0,8,0" />
                    <Button x:Name="ClearProductFilterButton" Content="Quitar filtro" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearProductFilterCommand}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="200" MinWidth="160" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Producto / SKU" Style="{StaticResource FilterLabelStyle}" />
                        <TextBox x:Name="SearchTextBox" Padding="8" VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Usuario" Style="{StaticResource FilterLabelStyle}" />
                        <TextBox x:Name="ActorSearchTextBox" Padding="8" VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 Text="{Binding ActorSearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Acción" Style="{StaticResource FilterLabelStyle}" />
                        <ComboBox x:Name="ActionComboBox" Padding="8,5"
                                  SelectedValuePath="Tag" SelectedValue="{Binding SelectedAction}">
                            <ComboBoxItem Content="Todos" Tag="{x:Null}" />
                            <ComboBoxItem Content="Creado" Tag="{x:Static productAudit:ProductAuditAction.Created}" />
                            <ComboBoxItem Content="Actualizado" Tag="{x:Static productAudit:ProductAuditAction.Updated}" />
                            <ComboBoxItem Content="Activado" Tag="{x:Static productAudit:ProductAuditAction.Activated}" />
                            <ComboBoxItem Content="Desactivado" Tag="{x:Static productAudit:ProductAuditAction.Deactivated}" />
                            <ComboBoxItem Content="Inventario ajustado" Tag="{x:Static productAudit:ProductAuditAction.InventoryAdjusted}" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="*" MinWidth="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Desde" Style="{StaticResource FilterLabelStyle}" />
                        <DatePicker x:Name="FromDatePicker" Language="es-MX" Loaded="DatePicker_Loaded"
                                    SelectedDate="{Binding FromDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Hasta" Style="{StaticResource FilterLabelStyle}" />
                        <DatePicker x:Name="ToDatePicker" Language="es-MX" Loaded="DatePicker_Loaded"
                                    SelectedDate="{Binding ToDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="SearchButton" Content="Buscar" Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" />
                        <Button x:Name="ClearFiltersButton" Content="Limpiar filtros" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding StatusMessage}" />

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
                <DataGrid x:Name="AuditGrid" BorderThickness="0" Background="Transparent"
                          ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha/Hora" Binding="{Binding OccurredAtLocalText}" Width="140" MinWidth="130" />
                        <DataGridTextColumn Header="Usuario" Binding="{Binding ActorDisplayName}" Width="120" MinWidth="100" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding ProductSku}" Width="100" MinWidth="90" />
                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="Acción" Binding="{Binding ActionText}" Width="110" MinWidth="100" />
                        <DataGridTextColumn Header="Resumen" Binding="{Binding SummaryText}" Width="2*" MinWidth="200" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding GeneralError}" Foreground="{StaticResource DangerBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PreviousPageButton" Content="Anterior" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PreviousPageCommand}" />
                    <TextBlock x:Name="PageNumberText" Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <Button x:Name="NextPageButton" Content="Siguiente" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding NextPageCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Panel de detalle read-only: sin botones Editar/Eliminar/Limpiar (TAREA 24D, sección 26). -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Detalle" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"
                           Foreground="{StaticResource PrimaryTextBrush}" />

                <StackPanel DataContext="{Binding SelectedEntry}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding OccurredAtLocalText}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4" />
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4">
                        <Run Text="Usuario: " /><Run Text="{Binding ActorDisplayName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4">
                        <Run Text="Producto: " /><Run Text="{Binding ProductName, Mode=OneWay}" />
                        <Run Text=" (" /><Run Text="{Binding ProductSku, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="Acción: " /><Run Text="{Binding ActionText, Mode=OneWay}" />
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FieldLabel}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <WrapPanel Margin="0,2,0,0">
                                            <TextBlock Text="{Binding OldValueDisplay}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text=" → " Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding NewValueDisplay}" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
