<Window x:Class="Pos.Desktop.RegisterSessions.CloseRegisterSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cierre de caja — PosPlatform"
        Height="600" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="32" IsEnabled="{Binding IsNotBusy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                    Text="Cierre de caja"
                    FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                    Text="Revise el resumen y confirme el cierre de esta caja."
                    Margin="0,0,0,16" TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Caja" />
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,8" VerticalAlignment="Center"
                        Text="{Binding RegisterName}" FontWeight="Bold" />

            <Label Grid.Row="1" Grid.Column="0" Content="Abierta por" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8" VerticalAlignment="Center"
                        Text="{Binding OpenedByDisplayName}" />

            <Label Grid.Row="2" Grid.Column="0" Content="Apertura" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8" VerticalAlignment="Center"
                        Text="{Binding OpenedAtText}" />

            <Label Grid.Row="3" Grid.Column="0" Content="Fondo inicial" />
            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8" VerticalAlignment="Center">
                <Run Text="{Binding OpeningAmountText, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding Currency, Mode=OneWay}" />
            </TextBlock>

            <Label Grid.Row="4" Grid.Column="0" Content="Ventas totales" />
            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8" VerticalAlignment="Center">
                <Run Text="{Binding GrossSalesAmountText, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding Currency, Mode=OneWay}" />
            </TextBlock>

            <Label Grid.Row="5" Grid.Column="0" Content="Ventas en efectivo" />
            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,8" VerticalAlignment="Center">
                <Run Text="{Binding CashSalesAmountText, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding Currency, Mode=OneWay}" />
            </TextBlock>

            <Label Grid.Row="6" Grid.Column="0" Content="Ventas con tarjeta" />
            <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,8" VerticalAlignment="Center">
                <Run Text="{Binding CardSalesAmountText, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding Currency, Mode=OneWay}" />
            </TextBlock>

            <Label Grid.Row="7" Grid.Column="0" Content="Efectivo esperado" />
            <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,8" VerticalAlignment="Center" FontWeight="Bold">
                <Run Text="{Binding ExpectedAmountText, Mode=OneWay}" />
                <Run Text=" " />
                <Run Text="{Binding Currency, Mode=OneWay}" />
            </TextBlock>

            <Label Grid.Row="8" Grid.Column="0" Content="Efectivo contado"
                    Target="{Binding ElementName=ClosingAmountTextBox}" />
            <TextBox x:Name="ClosingAmountTextBox" Grid.Row="8" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="0"
                    Text="{Binding ClosingAmountText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Diferencia: " FontWeight="Bold" />
            <TextBlock Text="{Binding DifferenceText}" FontWeight="Bold" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding GeneralError}"
                    Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="160" Height="6" VerticalAlignment="Center" />
            <TextBlock Text="Cerrando caja…" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="120" Margin="0,0,8,0" TabIndex="2"
                    Command="{Binding CancelCommand}" />
            <Button Content="Confirmar cierre" Width="140" TabIndex="1"
                    IsDefault="True" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</Window>
