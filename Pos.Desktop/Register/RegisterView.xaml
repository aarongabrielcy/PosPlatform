<UserControl x:Class="Pos.Desktop.Register.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Pos.Desktop;component/Themes/AppColors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Caja" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Resumen de la caja actual." Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" MaxWidth="480" HorizontalAlignment="Left">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Caja" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,8" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding RegisterName}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Abierta desde" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding OpenedAtText}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fondo inicial" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding OpeningAmountText}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Usuario" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding OpenedByDisplayName}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Estado" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding StatusText}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                            Visibility="{Binding CanManageCashMovements, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button x:Name="CashInButton" Content="Entrada de efectivo" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CashInCommand}" />
                    <Button x:Name="CashOutButton" Content="Salida de efectivo"
                            Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CashOutCommand}" />
                </StackPanel>

                <Button x:Name="CloseRegisterButton" Content="Cerrar caja" HorizontalAlignment="Left" Margin="0,16,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CloseRegisterCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,16,0,0"
                Visibility="{Binding CanViewCashMovements, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Movimientos de caja" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding MovementsError}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Movements}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TypeText}" />
                                <TextBlock Grid.Column="1" Text="{Binding AmountText}" />
                                <TextBlock Grid.Column="2" Text="{Binding Reason}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="3" Text="{Binding ActorDisplayName}" />
                                <TextBlock Grid.Column="4" Text="{Binding CreatedAtText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
