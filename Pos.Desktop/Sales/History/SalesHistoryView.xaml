<UserControl x:Class="Pos.Desktop.Sales.History.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sales="clr-namespace:Pos.Domain.Sales;assembly=Pos.Domain"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Pos.Desktop;component/Themes/AppColors.xaml" />
                <ResourceDictionary Source="/Pos.Desktop;component/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="DetailValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="24">

        <!-- LISTA (sección 22): tabla completa con filtros, resumen y paginación. -->
        <Grid Visibility="{Binding IsShowingList, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Historial de ventas" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Consulta ventas completadas, filtra por fecha, cajero, caja o método de pago." Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Resumen del FILTRO COMPLETO, no de la página cargada (sección 16/17). -->
            <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Ventas" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                        <TextBlock Text="{Binding SummaryCount}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total vendido" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                        <TextBlock Text="{Binding SummaryTotalText}" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Por método de pago" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                        <TextBlock Text="{Binding SummaryBreakdownText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{StaticResource PrimaryTextBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="170" MinWidth="150" />
                        <ColumnDefinition Width="170" MinWidth="150" />
                        <ColumnDefinition Width="180" MinWidth="160" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Buscar" Style="{StaticResource FilterLabelStyle}" />
                        <TextBox x:Name="SearchTextBox" Padding="8" VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 ToolTip="Buscar por número de venta, SKU o nombre del producto"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Desde" Style="{StaticResource FilterLabelStyle}" />
                        <DatePicker x:Name="FromDatePicker" Language="es-MX" Loaded="DatePicker_Loaded"
                                    SelectedDate="{Binding FromDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Hasta" Style="{StaticResource FilterLabelStyle}" />
                        <DatePicker x:Name="ToDatePicker" Language="es-MX" Loaded="DatePicker_Loaded"
                                    SelectedDate="{Binding ToDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="SearchButton" Content="Buscar" Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" />
                        <Button x:Name="ClearFiltersButton" Content="Limpiar filtros" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="180" />
                        <ColumnDefinition Width="220" MinWidth="180" />
                        <ColumnDefinition Width="200" MinWidth="170" />
                        <ColumnDefinition Width="*" MinWidth="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Cajero" Style="{StaticResource FilterLabelStyle}" />
                        <ComboBox x:Name="CashierComboBox" Padding="8,5"
                                  ItemsSource="{Binding CashierOptions}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedCashier}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Caja" Style="{StaticResource FilterLabelStyle}" />
                        <ComboBox x:Name="RegisterComboBox" Padding="8,5"
                                  ItemsSource="{Binding RegisterOptions}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedRegister}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Método de pago" Style="{StaticResource FilterLabelStyle}" />
                        <ComboBox x:Name="PaymentMethodComboBox" Padding="8,5"
                                  SelectedValuePath="Tag" SelectedValue="{Binding SelectedPaymentMethod}">
                            <ComboBoxItem Content="Todos" Tag="{x:Null}" />
                            <ComboBoxItem Content="Efectivo" Tag="{x:Static sales:PaymentMethod.Cash}" />
                            <ComboBoxItem Content="Tarjeta" Tag="{x:Static sales:PaymentMethod.Card}" />
                            <ComboBoxItem Content="Transferencia bancaria" Tag="{x:Static sales:PaymentMethod.BankTransfer}" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="RefreshButton" Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="DateRangeErrorText" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}" Text="{Binding DateRangeError}" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding StatusMessage}" />

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
                <DataGrid x:Name="SalesHistoryGrid" BorderThickness="0" Background="Transparent"
                          ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha/Hora" Binding="{Binding CompletedAtLocalText}" Width="140" MinWidth="130" />
                        <DataGridTextColumn Header="Venta" Binding="{Binding SaleIdShortText}" Width="90" MinWidth="80" />
                        <DataGridTextColumn Header="Cajero" Binding="{Binding CashierDisplayName}" Width="130" MinWidth="110" />
                        <DataGridTextColumn Header="Caja" Binding="{Binding RegisterName}" Width="110" MinWidth="100" />
                        <DataGridTextColumn Header="Artículos" Binding="{Binding ItemCountText}" Width="80" MinWidth="70" />
                        <DataGridTextColumn Header="Pago" Binding="{Binding PaymentSummaryText}" Width="2*" MinWidth="160" />
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="110" MinWidth="100" />
                        <DataGridTemplateColumn Header="Acciones" Width="70" MinWidth="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TableIconButtonStyle}"
                                            ToolTip="Ver detalle"
                                            AutomationProperties.Name="Ver detalle"
                                            Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Fill="{StaticResource PrimaryTextBrush}" Data="{StaticResource IconHistory}" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding GeneralError}" Foreground="{StaticResource DangerBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Anterior" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PreviousPageCommand}" />
                    <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <Button Content="Siguiente" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding NextPageCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- DETALLE (sección 22/23 de 25B; TAREA 25B-FIX secciones 3/6/8): vista completa del
             comprobante, no un drawer estrecho. Read-only: sin botón "Imprimir" (pertenece a 25C,
             sección 24). IMPORTANTE: este Grid raíz NO fija su propio DataContext — si lo hiciera,
             el binding de Visibility (IsShowingDetail, propiedad de SalesHistoryViewModel) intentaría
             resolverse contra ese DataContext local en vez del heredado, fallaría en silencio y
             Visibility caería a su valor por defecto (Visible), dejando el panel siempre visible
             encima de la Lista (bug corregido en 25B-FIX). Solo los contenedores de contenido de las
             filas 2-5 fijan DataContext="{Binding SelectedSaleDetail}", nunca el Grid raíz. -->
        <Grid Visibility="{Binding IsShowingDetail, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Volver. Fila propia, nunca superpuesta con el título "Historial de ventas"
                 de LISTA (sección 6). -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="&#8592; Volver al historial" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CloseDetailCommand}" />
            </StackPanel>

            <!-- Row 1: Header, solo el título (sección 8: separado de la metadata). -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="Detalle de venta" Style="{StaticResource PageTitleStyle}" />
            </StackPanel>

            <!-- Row 2: tarjeta de metadata (Venta/Fecha/Cajero/Caja). -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16" DataContext="{Binding SelectedSaleDetail}">
                <UniformGrid Rows="1">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Venta" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Text="{Binding SaleIdText}" Style="{StaticResource DetailValueStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Fecha/Hora" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Text="{Binding CompletedAtLocalText}" Style="{StaticResource DetailValueStyle}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Cajero" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Text="{Binding CashierDisplayName}" Style="{StaticResource DetailValueStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Caja" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Text="{Binding RegisterName}" Style="{StaticResource DetailValueStyle}" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Row 3: SaleLines DataGrid (*), recibe prioridad de alto. -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,16" DataContext="{Binding SelectedSaleDetail}">
                <DataGrid BorderThickness="0" Background="Transparent"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding ProductSku}" Width="120" MinWidth="100" />
                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" MinWidth="180" />
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding QuantityText}" Width="100" MinWidth="90" />
                        <DataGridTextColumn Header="Precio unitario" Binding="{Binding UnitPriceText}" Width="130" MinWidth="110" />
                        <DataGridTextColumn Header="Importe" Binding="{Binding LineTotalText}" Width="130" MinWidth="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Row 4: Pagos. -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,16" DataContext="{Binding SelectedSaleDetail}">
                <StackPanel>
                    <TextBlock Text="Pagos" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <ItemsControl ItemsSource="{Binding Payments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding MethodText}" Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AmountText}" Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PaidAtLocalText}" Foreground="{StaticResource SecondaryTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Row 5: Totales. Grid con filas/columnas explícitas (etiqueta/valor) por fila
                 (TAREA 25B-FIX-2): cada fila usada tener label y value en la misma celda
                 (Grid.Row/Column implícitos en 0,0), lo que los hacía superponerse ("montado").
                 Ahora cada TextBlock declara su propia Grid.Row/Grid.Column. -->
            <Border Grid.Row="5" Style="{StaticResource CardStyle}" DataContext="{Binding SelectedSaleDetail}">
                <Grid HorizontalAlignment="Right" MinWidth="260">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120" />
                        <ColumnDefinition Width="Auto" MinWidth="140" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SubtotalLabelText" Grid.Row="0" Grid.Column="0" Text="Subtotal" Margin="0,0,24,6"
                               VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="SubtotalValueText" Grid.Row="0" Grid.Column="1" Text="{Binding SubtotalText}" Margin="0,0,0,6"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}" />

                    <TextBlock x:Name="TotalLabelText" Grid.Row="1" Grid.Column="0" Text="Total" Margin="0,0,24,0"
                               VerticalAlignment="Center" FontWeight="Bold" FontSize="18"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock x:Name="TotalValueText" Grid.Row="1" Grid.Column="1" Text="{Binding TotalText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryTextBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
