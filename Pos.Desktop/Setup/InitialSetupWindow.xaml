<Window x:Class="Pos.Desktop.Setup.InitialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Configuración inicial — PosPlatform"
        Height="768" Width="1024"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Geometry x:Key="EyeIconGeometry">M12,4.5C7,4.5 2.73,7.61 1,12 2.73,16.39 7,19.5 12,19.5 17,19.5 21.27,16.39 23,12 21.27,7.61 17,4.5 12,4.5M12,17C9.24,17 7,14.76 7,12 7,9.24 9.24,7 12,7 14.76,7 17,9.24 17,12 17,14.76 14.76,17 12,17M12,9C10.34,9 9,10.34 9,12 9,13.66 10.34,15 12,15 13.66,15 15,13.66 15,12 15,10.34 13.66,9 12,9Z</Geometry>
        <Geometry x:Key="EyeOffIconGeometry">M12,7C14.76,7 17,9.24 17,12C17,12.65 16.87,13.26 16.64,13.83L19.57,16.76C21.07,15.49 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8.03,5.2L10.17,7.34C10.74,7.13 11.35,7 12,7M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.09L19.73,22L21,20.73L3.27,3L2,4.27M7.53,9.8L9.08,11.35C9.03,11.56 9,11.78 9,12C9,13.66 10.34,15 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17C9.24,17 7,14.76 7,12C7,11.21 7.2,10.47 7.53,9.8M11.84,9.02L14.99,12.17L15,12C15,10.34 13.66,9 12,9L11.84,9.02Z</Geometry>

        <Style x:Key="PasswordVisibilityButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
        </Style>
    </Window.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                    Text="Configuración inicial del negocio"
                    FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                    Text="Complete los siguientes datos para configurar este equipo por primera vez."
                    Margin="0,0,0,16" TextWrapping="Wrap" />

        <Grid Grid.Row="2" IsEnabled="{Binding IsNotBusy}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Nombre del negocio"
                    Target="{Binding ElementName=OrganizationNameTextBox}" />
            <TextBox x:Name="OrganizationNameTextBox" Grid.Row="0" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="0"
                    Text="{Binding OrganizationName, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="1" Grid.Column="0" Content="Nombre de la sucursal"
                    Target="{Binding ElementName=BranchNameTextBox}" />
            <TextBox x:Name="BranchNameTextBox" Grid.Row="1" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="1"
                    Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="2" Grid.Column="0" Content="Nombre de la caja"
                    Target="{Binding ElementName=RegisterNameTextBox}" />
            <TextBox x:Name="RegisterNameTextBox" Grid.Row="2" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="2"
                    Text="{Binding RegisterName, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="3" Grid.Column="0" Content="Usuario administrador"
                    Target="{Binding ElementName=AdministratorUsernameTextBox}" />
            <TextBox x:Name="AdministratorUsernameTextBox" Grid.Row="3" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="3"
                    Text="{Binding AdministratorUsername, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="4" Grid.Column="0" Content="Nombre visible del administrador"
                    Target="{Binding ElementName=AdministratorDisplayNameTextBox}" />
            <TextBox x:Name="AdministratorDisplayNameTextBox" Grid.Row="4" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="4"
                    Text="{Binding AdministratorDisplayName, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="5" Grid.Column="0" Content="Contraseña"
                    Target="{Binding ElementName=PasswordBox}" />
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox" Grid.Column="0"
                        Padding="6,4" TabIndex="5" MaxLength="256" />
                <TextBox x:Name="PasswordVisibleTextBox" Grid.Column="0"
                        Padding="6,4" TabIndex="5" MaxLength="256"
                        Visibility="Collapsed" />
                <Button x:Name="PasswordVisibilityButton" Grid.Column="1" TabIndex="6"
                        Style="{StaticResource PasswordVisibilityButtonStyle}"
                        ToolTip="Mostrar contraseña"
                        AutomationProperties.Name="Mostrar contraseña"
                        Click="OnTogglePasswordVisibilityClick">
                    <Path x:Name="PasswordVisibilityIcon" Data="{StaticResource EyeIconGeometry}"
                            Fill="{x:Static SystemColors.ControlTextBrush}"
                            Width="16" Height="16" Stretch="Uniform" />
                </Button>
            </Grid>

            <Label Grid.Row="6" Grid.Column="0" Content="Confirmar contraseña"
                    Target="{Binding ElementName=ConfirmPasswordBox}" />
            <Grid Grid.Row="6" Grid.Column="1" Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="0"
                        Padding="6,4" TabIndex="7" MaxLength="256" />
                <TextBox x:Name="ConfirmPasswordVisibleTextBox" Grid.Column="0"
                        Padding="6,4" TabIndex="7" MaxLength="256"
                        Visibility="Collapsed" />
                <Button x:Name="ConfirmPasswordVisibilityButton" Grid.Column="1" TabIndex="8"
                        Style="{StaticResource PasswordVisibilityButtonStyle}"
                        ToolTip="Mostrar contraseña"
                        AutomationProperties.Name="Mostrar contraseña"
                        Click="OnToggleConfirmPasswordVisibilityClick">
                    <Path x:Name="ConfirmPasswordVisibilityIcon" Data="{StaticResource EyeIconGeometry}"
                            Fill="{x:Static SystemColors.ControlTextBrush}"
                            Width="16" Height="16" Stretch="Uniform" />
                </Button>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding GeneralError}"
                    Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="160" Height="6" VerticalAlignment="Center" />
            <TextBlock Text="Configurando…" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="100" Margin="0,0,8,0" IsCancel="True" TabIndex="10" />
            <Button x:Name="ConfigurarButton" Content="Configurar" Width="120" TabIndex="9"
                    IsDefault="True" IsEnabled="{Binding IsNotBusy}"
                    Click="OnConfigurarClick" />
        </StackPanel>
    </Grid>
</Window>
