<Window x:Class="Pos.Desktop.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Iniciar sesión — PosPlatform"
        Height="420" Width="420"
        MinHeight="420" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Geometry x:Key="EyeIconGeometry">M12,4.5C7,4.5 2.73,7.61 1,12 2.73,16.39 7,19.5 12,19.5 17,19.5 21.27,16.39 23,12 21.27,7.61 17,4.5 12,4.5M12,17C9.24,17 7,14.76 7,12 7,9.24 9.24,7 12,7 14.76,7 17,9.24 17,12 17,14.76 14.76,17 12,17M12,9C10.34,9 9,10.34 9,12 9,13.66 10.34,15 12,15 13.66,15 15,13.66 15,12 15,10.34 13.66,9 12,9Z</Geometry>
        <Geometry x:Key="EyeOffIconGeometry">M12,7C14.76,7 17,9.24 17,12C17,12.65 16.87,13.26 16.64,13.83L19.57,16.76C21.07,15.49 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8.03,5.2L10.17,7.34C10.74,7.13 11.35,7 12,7M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.09L19.73,22L21,20.73L3.27,3L2,4.27M7.53,9.8L9.08,11.35C9.03,11.56 9,11.78 9,12C9,13.66 10.34,15 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17C9.24,17 7,14.76 7,12C7,11.21 7.2,10.47 7.53,9.8M11.84,9.02L14.99,12.17L15,12C15,10.34 13.66,9 12,9L11.84,9.02Z</Geometry>

        <Style x:Key="PasswordVisibilityButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
        </Style>
    </Window.Resources>
    <Grid Margin="32" IsEnabled="{Binding IsNotBusy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                    Text="PosPlatform"
                    FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                    Text="Inicie sesión para continuar."
                    Margin="0,0,0,16" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <Label Content="Usuario" Target="{Binding ElementName=UsernameTextBox}" />
            <TextBox x:Name="UsernameTextBox"
                    Padding="6,4" TabIndex="0"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <Label Content="Contraseña" Target="{Binding ElementName=PasswordBox}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox" Grid.Column="0"
                        Padding="6,4" TabIndex="1" MaxLength="256" />
                <TextBox x:Name="PasswordVisibleTextBox" Grid.Column="0"
                        Padding="6,4" TabIndex="1" MaxLength="256"
                        Visibility="Collapsed" />
                <Button x:Name="PasswordVisibilityButton" Grid.Column="1" TabIndex="2"
                        Style="{StaticResource PasswordVisibilityButtonStyle}"
                        ToolTip="Mostrar contraseña"
                        AutomationProperties.Name="Mostrar contraseña"
                        Click="OnTogglePasswordVisibilityClick">
                    <Path x:Name="PasswordVisibilityIcon" Data="{StaticResource EyeIconGeometry}"
                            Fill="{x:Static SystemColors.ControlTextBrush}"
                            Width="16" Height="16" Stretch="Uniform" />
                </Button>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding GeneralError}"
                    Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="160" Height="6" VerticalAlignment="Center" />
            <TextBlock Text="Iniciando sesión…" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SalirButton" Content="Salir" Width="100" Margin="0,0,8,0"
                    TabIndex="4" IsCancel="True" />
            <Button x:Name="IniciarSesionButton" Content="Iniciar sesión" Width="140" TabIndex="3"
                    IsDefault="True" IsEnabled="{Binding IsNotBusy}"
                    Click="OnIniciarSesionClick" />
        </StackPanel>
    </Grid>
</Window>
