<UserControl x:Class="Pos.Desktop.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Pos.Desktop;component/Themes/AppColors.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Resumen general de la operación." Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,20">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0"
                    Visibility="{Binding CanViewProductCards, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Productos" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                    <TextBlock Text="{Binding TotalProducts}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0"
                    Visibility="{Binding CanViewProductCards, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Stock bajo" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                    <TextBlock x:Name="LowStockCountText" Text="{Binding LowStockCount}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0"
                    Visibility="{Binding CanViewProductCards, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Sin existencia" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                    <TextBlock x:Name="OutOfStockCountText" Text="{Binding OutOfStockCount}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Caja" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                    <TextBlock x:Name="RegisterStatusTextBlock" Text="{Binding RegisterStatusText}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding RegisterName}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Venta actual" Style="{StaticResource PageSubtitleStyle}" Margin="0" />
                    <TextBlock x:Name="CartTotalTextBlock" Text="{Binding CartTotalText}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding CartLineCount, StringFormat={}{0} líneas}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="2" Text="{Binding GeneralError}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8" />

        <Border Grid.Row="3" Style="{StaticResource CardStyle}"
                Visibility="{Binding CanViewProductCards, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Productos con stock bajo" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12" />

                <TextBlock DockPanel.Dock="Top" x:Name="LowStockStatusText" Text="{Binding LowStockStatusMessage}"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8" />

                <DataGrid x:Name="LowStockGrid" ItemsSource="{Binding LowStockItems}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow" BorderThickness="0">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ViewProductCommand}"
                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="120" />
                        <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Existencia" Binding="{Binding Quantity}" Width="100" />
                        <DataGridTextColumn Header="Punto de reorden" Binding="{Binding ReorderPoint}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
