<Window x:Class="Pos.Desktop.Products.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Editar producto — PosPlatform"
        Height="620" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="32" IsEnabled="{Binding IsNotBusy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                    Text="Editar producto"
                    FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="SKU" Target="{Binding ElementName=SkuTextBox}" />
            <TextBox x:Name="SkuTextBox" Grid.Row="0" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="0"
                    Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="1" Grid.Column="0" Content="Código de barras" Target="{Binding ElementName=BarcodeTextBox}" />
            <TextBox x:Name="BarcodeTextBox" Grid.Row="1" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="1"
                    Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="2" Grid.Column="0" Content="Nombre" Target="{Binding ElementName=NameTextBox}" />
            <TextBox x:Name="NameTextBox" Grid.Row="2" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="2"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="3" Grid.Column="0" Content="Descripción" Target="{Binding ElementName=DescriptionTextBox}" />
            <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="3"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="4" Grid.Column="0" Content="Precio de venta" Target="{Binding ElementName=SalePriceTextBox}" />
            <TextBox x:Name="SalePriceTextBox" Grid.Row="4" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="4"
                    Text="{Binding SalePriceText, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="5" Grid.Column="0" Content="Costo" Target="{Binding ElementName=CostTextBox}" />
            <TextBox x:Name="CostTextBox" Grid.Row="5" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="5"
                    Text="{Binding CostText, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="6" Grid.Column="0" Content="Controla inventario" />
            <CheckBox Grid.Row="6" Grid.Column="1"
                    Margin="0,10" VerticalAlignment="Center"
                    IsEnabled="False"
                    IsChecked="{Binding TracksInventory, Mode=OneWay}" />

            <Label Grid.Row="7" Grid.Column="0" Content="Existencia actual" />
            <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,10" VerticalAlignment="Center"
                    Text="{Binding CurrentQuantityText, Mode=OneWay}" />

            <Label Grid.Row="8" Grid.Column="0" Content="Punto de reorden" Target="{Binding ElementName=ReorderPointTextBox}" />
            <TextBox x:Name="ReorderPointTextBox" Grid.Row="8" Grid.Column="1"
                    Margin="0,6" Padding="6,4" TabIndex="6"
                    IsEnabled="{Binding TracksInventory}"
                    Text="{Binding ReorderPointText, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="9" Grid.Column="0" Content="Estado" />
            <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,10" VerticalAlignment="Center"
                    Text="{Binding IsActiveText, Mode=OneWay}" />
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding GeneralError}"
                    Foreground="Red" TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="160" Height="6" VerticalAlignment="Center" />
            <TextBlock Text="Procesando…" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="ToggleActiveButton" Content="{Binding ToggleActiveButtonText}"
                        MinWidth="100" Padding="12,6" Margin="0,0,8,0" TabIndex="7"
                        Command="{Binding ToggleActiveCommand}" />
                <Button x:Name="AdjustInventoryButton" Content="Ajustar inventario"
                        MinWidth="140" Padding="12,6" TabIndex="8"
                        IsEnabled="{Binding TracksInventory}"
                        Command="{Binding AdjustInventoryCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="Cancelar"
                        MinWidth="100" Padding="12,6" Margin="0,0,8,0" TabIndex="10"
                        Command="{Binding CancelCommand}" />
                <Button x:Name="SaveButton" Content="Guardar cambios"
                        MinWidth="130" Padding="16,6" TabIndex="9"
                        IsDefault="True" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
