<Window x:Class="Pos.Desktop.Activation.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Activación — PosPlatform"
        Height="360" Width="420"
        MinHeight="360" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="32" IsEnabled="{Binding IsNotBusy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                    Text="PosPlatform"
                    FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                    Text="Esta instalación no ha sido activada. Ingrese el código de activación entregado por su administrador."
                    Margin="0,0,0,16" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <Label Content="Código de activación" Target="{Binding ElementName=EnrollmentCodeTextBox}" />
            <TextBox x:Name="EnrollmentCodeTextBox"
                    Padding="6,4" TabIndex="0"
                    Text="{Binding EnrollmentCode, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding GeneralError}"
                    Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,8,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="160" Height="6" VerticalAlignment="Center" />
            <TextBlock Text="Activando…" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SalirButton" Content="Salir" Width="100" Margin="0,0,8,0"
                    TabIndex="2" IsCancel="True" />
            <Button x:Name="ActivarButton" Content="Activar PosPlatform" Width="160" TabIndex="1"
                    IsDefault="True" IsEnabled="{Binding IsNotBusy}"
                    Click="OnActivarClick" />
        </StackPanel>
    </Grid>
</Window>
