<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Iconografía vectorial (TAREA 24C.1, sección 7): geometrías simples en un lienzo de
         16x16, pensadas para Path.Fill (regla EvenOdd por defecto al parsear, usada
         deliberadamente en IconSettings para crear el efecto de anillo). Sin emojis, sin
         dependencia de fuentes de iconos (Segoe Fluent Icons no está garantizado en todas las
         versiones de Windows soportadas). -->

    <Geometry x:Key="IconMenu">M0,1 H16 V3 H0 Z M0,7 H16 V9 H0 Z M0,13 H16 V15 H0 Z</Geometry>

    <Geometry x:Key="IconDashboard">M0,0 H7 V7 H0 Z M9,0 H16 V7 H9 Z M0,9 H7 V16 H0 Z M9,9 H16 V16 H9 Z</Geometry>

    <Geometry x:Key="IconSales">M2,3 L4,3 L6,11 L14,11 L16,5 L5,5 Z M3.7,14 A1.3,1.3 0 1,0 6.3,14 A1.3,1.3 0 1,0 3.7,14 Z M10.7,14 A1.3,1.3 0 1,0 13.3,14 A1.3,1.3 0 1,0 10.7,14 Z</Geometry>

    <Geometry x:Key="IconProducts">M1,5 L8,2 L15,5 L15,12 L8,15 L1,12 Z</Geometry>

    <Geometry x:Key="IconInventory">M8,0 L15,3 L8,6 L1,3 Z M8,5 L15,8 L8,11 L1,8 Z M8,10 L15,13 L8,16 L1,13 Z</Geometry>

    <Geometry x:Key="IconRegister">M1,4 H15 V6 H1 Z M2,7 H14 V14 H2 Z</Geometry>

    <Geometry x:Key="IconSettings">M8,1 A7,7 0 1,0 8.001,1 Z M8,5 A3,3 0 1,0 8.001,5 Z</Geometry>

    <Geometry x:Key="IconUser">M8,1 A3,3 0 1,0 8.001,1 Z M2,16 L2,13 A6,4 0 0,1 14,13 L14,16 Z</Geometry>

    <Geometry x:Key="IconLogout">M2,2 H4 V14 H2 Z M2,2 H8 V4 H2 Z M2,12 H8 V14 H2 Z M9,7 H13 V9 H9 Z M12,4.5 L16,8 L12,11.5 Z</Geometry>

    <!-- Campana del centro de notificaciones (TAREA 24E, sección 24): mismo criterio que el
         resto de IconXxx, geometría vectorial hecha a mano, sin fuentes de iconos ni emoji. -->
    <Geometry x:Key="IconBell">
        M8,1 C6.3,1 5,2.3 5,4 L5,7.5 C5,8.8 4.4,10 3.3,10.8 L3,11 L13,11 L12.7,10.8
        C11.6,10 11,8.8 11,7.5 L11,4 C11,2.3 9.7,1 8,1 Z
        M6.3,12.3 A1.7,1.7 0 0 0 9.7,12.3 Z
    </Geometry>

    <!-- Cerrar panel del centro de notificaciones: X formada por dos barras diagonales, mismo
         estilo de polígonos simples que IconSales/IconLogout. -->
    <Geometry x:Key="IconClose">M1,3 L3,1 L15,13 L13,15 Z M13,1 L15,3 L3,15 L1,13 Z</Geometry>

    <!-- Iconos de acción de fila en DataGrid (TAREA 24G-FIX, sección 8): sin emoji, mismo criterio
         de geometrías simples de trazo grueso que el resto del archivo. -->

    <!-- Editar (lápiz): cuerpo del lápiz + virola + punta, tres cuadriláteros consecutivos sin
         superposición para evitar el efecto de "anillo" de EvenOdd (deliberado en IconSettings,
         no deseado aquí). -->
    <Geometry x:Key="IconEdit">
        M1,15 L1,12.2 L9,4.2 L11.8,7 L3.8,15 Z
        M9,4.2 L11,2.2 L13.8,5 L11.8,7 Z
        M11,2.2 L12.4,0.8 L15.2,3.6 L13.8,5 Z
    </Geometry>

    <!-- Ver movimientos de stock (reloj/historial): anillo exterior (mismo truco que IconSettings)
         más manecillas, contenidas dentro del radio interior para no cruzar el anillo. -->
    <Geometry x:Key="IconHistory">
        M8,1 A7,7 0 1,0 8.001,1 Z
        M8,2 A6,6 0 1,0 8.001,2 Z
        M7.4,4 H8.6 V8 H7.4 Z
        M8,8 L11,10 L11.7,9 L8.7,7 Z
    </Geometry>

    <!-- Ajustar existencia (sliders/control deslizante): tres rieles con su control, cada riel
         interrumpido para no superponerse con el círculo del control. -->
    <Geometry x:Key="IconAdjust">
        M1,2.5 H3.2 V3.5 H1 Z
        M6.8,2.5 H15 V3.5 H6.8 Z
        M5,1.5 A1.5,1.5 0 1,0 5.001,1.5 Z
        M1,7.5 H9.2 V8.5 H1 Z
        M12.8,7.5 H15 V8.5 H12.8 Z
        M11,6.5 A1.5,1.5 0 1,0 11.001,6.5 Z
        M1,12.5 H5.2 V13.5 H1 Z
        M8.8,12.5 H15 V13.5 H8.8 Z
        M7,11.5 A1.5,1.5 0 1,0 7.001,11.5 Z
    </Geometry>

    <!-- Ver actividad/auditoría (documento con líneas): rectángulo sólido con tres muescas
         horizontales (EvenOdd las deja "huecas", efecto de líneas de texto). -->
    <Geometry x:Key="IconAuditDocument">
        M3,1 H13 V15 H3 Z
        M5,4 H11 V5 H5 Z
        M5,7 H11 V8 H5 Z
        M5,10 H9 V11 H5 Z
    </Geometry>

</ResourceDictionary>
